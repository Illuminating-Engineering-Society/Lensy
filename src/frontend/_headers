# Security headers for static frontend assets (Cloudflare Workers static
# assets honors this file). API responses set their own headers in api.js.
#
# CSP notes: the UI uses inline <script>/<style> plus the Tailwind CDN
# runtime, so 'unsafe-inline' and that one CDN host are required until the
# frontend moves to a build step. connect-src 'self' — the API is same-origin.
# frame-ancestors 'none' blocks clickjacking wrappers around the search UI.
#
# img-src also allows ies.org: an ANSI/IES LS-1 definition may include a figure,
# and Definition result cards reproduce the definition as published (client
# DO33). The figures are hosted on ies.org's own media library, so the two hosts
# below are the entire surface — the definition HTML is sanitized to an
# allowlist server-side (src/lib/definitions.js) before it is ever rendered.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://ies.org https://www.ies.org; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
